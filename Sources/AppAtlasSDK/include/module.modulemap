// An explicit module, not the one SwiftPM would synthesize: some Xcode
// toolchains fail to generate a usable map for a pure Objective-C package
// and leave a consumer with "No such module 'AppAtlasSDK'". The headers are
// the public surface, each self-contained; the submodules keep the private
// headers out of the umbrella.
module AppAtlasSDK {
    header "Atlas.h"
    header "ATLCore.h"
    header "ATLCrash.h"
    header "ATLLink.h"
    header "ATLLinks.h"

    export *
}
